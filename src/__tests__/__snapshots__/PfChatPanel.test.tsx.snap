exports[`PfChatPanel > steps, question and stop-at-limit > renders messages without the new props exactly as before 1`] = `"<div style="max-width: 92%; padding: 8px 12px; border-radius: var(--pf-radius-md); font-size: 14px; overflow-wrap: anywhere; align-self: flex-end; background: var(--pf-accent-muted);" data-testid="pf-chat-message-m1"><span style="position: absolute; width: 1px; height: 1px; overflow: hidden; white-space: nowrap;">You: </span><div style="white-space: pre-wrap;">Hello there</div></div><div style="max-width: 92%; padding: 8px 12px; border-radius: var(--pf-radius-md); font-size: 14px; overflow-wrap: anywhere; align-self: flex-start; background: var(--pf-bg-surface-alt);" data-testid="pf-chat-message-m2"><span style="position: absolute; width: 1px; height: 1px; overflow: hidden; white-space: nowrap;">Assistant: </span><div style="white-space: pre-wrap;">Hi, how can I help?</div><div style="margin-top: 4px; font-size: 12px; color: var(--pf-text-muted);">Sources: <a href="https://example.com/1" target="_blank" rel="noreferrer" style="color: var(--pf-accent);">Doc one</a>, <span>Plain source</span></div><div style="margin-top: 4px; font-size: 12px; color: var(--pf-text-muted);">Model A · $0.002</div></div><div style="max-width: 92%; padding: 8px 12px; border-radius: var(--pf-radius-md); font-size: 14px; overflow-wrap: anywhere; align-self: flex-start; background: var(--pf-bg-surface-alt);" data-testid="pf-chat-message-m3"><span style="position: absolute; width: 1px; height: 1px; overflow: hidden; white-space: nowrap;">Assistant: </span><div style="white-space: pre-wrap;">Thinking<span role="img" aria-label="Typing"> …</span></div></div><div style="max-width: 92%; padding: 8px 12px; border-radius: var(--pf-radius-md); font-size: 14px; overflow-wrap: anywhere; align-self: flex-start; background: var(--pf-bg-surface-alt);" data-testid="pf-chat-message-m4"><span style="position: absolute; width: 1px; height: 1px; overflow: hidden; white-space: nowrap;">Assistant: </span><div style="white-space: pre-wrap;">Half an answer</div><div style="margin-top: 4px; font-size: 12px; color: var(--pf-danger);">It broke</div></div>"`;
